<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GameUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <ui:VisualElement name="menuScreen" class="screen screen--out hidden" picking-mode="Ignore">
            <ui:VisualElement class="safe-area" picking-mode="Ignore">
                <ui:VisualElement class="screen-content" picking-mode="Ignore">
                    <ui:VisualElement class="top-bar" picking-mode="Ignore">
                        <ui:VisualElement class="chip-group">
                            <ui:VisualElement class="chip">
                                <ui:VisualElement class="icon icon-coin" />
                                <ui:Label name="menuCoinsValue" text="0" class="chip-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="chip chip--next">
                                <ui:VisualElement class="icon icon-key" />
                                <ui:Label name="menuKeysValue" text="0" class="chip-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="homePage" class="page" picking-mode="Ignore">
                        <ui:VisualElement class="logo" picking-mode="Ignore">
                            <ui:Label text="#ui.title" class="logo-title over-scene" />
                            <ui:VisualElement class="logo-rule" />
                            <ui:VisualElement class="logo-tag">
                                <ui:Label text="#ui.tagline" class="logo-tagline" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="chip chip-best">
                            <ui:VisualElement class="icon icon-trophy" />
                            <ui:Label text="#ui.best" class="chip-label" />
                            <ui:Label name="menuBestValue" text="0" class="chip-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                        <ui:VisualElement class="nameplate">
                            <ui:Button name="prevCharacterButton" class="icon-button">
                                <ui:VisualElement class="icon icon-chevron-left" picking-mode="Ignore" />
                            </ui:Button>
                            <ui:VisualElement name="characterPortraitTile" class="portrait-tile nameplate-portrait" picking-mode="Ignore">
                                <ui:VisualElement class="portrait-spot" picking-mode="Ignore" />
                                <ui:VisualElement name="characterPortrait" class="portrait-image" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="selector-info" picking-mode="Ignore">
                                <ui:Label text="#ui.character" class="eyebrow eyebrow--start" />
                                <ui:Label name="characterName" class="selector-name" />
                                <ui:VisualElement name="abilityChip" class="ability-chip">
                                    <ui:VisualElement class="icon icon-small icon-bolt" />
                                    <ui:Label name="characterAbility" class="ability-chip-label" />
                                </ui:VisualElement>
                                <ui:VisualElement name="automatedChip" class="danger-chip hidden">
                                    <ui:Label text="#ui.automated" class="danger-chip-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button name="nextCharacterButton" class="icon-button">
                                <ui:VisualElement class="icon icon-chevron-right" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="accessory-row">
                            <ui:VisualElement class="chip">
                                <ui:VisualElement class="icon icon-chair" />
                                <ui:Label name="accessoryName" class="chip-label" />
                                <ui:Label name="accessoryCount" text="0" class="chip-value" />
                            </ui:VisualElement>
                            <ui:Button name="accessoryBuyButton" class="buy-button">
                                <ui:Label text="+1" class="buy-label" picking-mode="Ignore" />
                                <ui:VisualElement class="icon icon-coin icon-gap" picking-mode="Ignore" />
                                <ui:Label name="accessoryPrice" text="0" class="buy-label" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:Button name="playButton" class="btn btn-primary btn-large">
                            <ui:VisualElement class="icon icon-play" picking-mode="Ignore" />
                            <ui:Label text="#ui.play" class="btn-label btn-label-large" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="buybackButton" class="btn btn-accent btn-large hidden">
                            <ui:Label text="#ui.buyback" class="btn-label btn-label-dark" picking-mode="Ignore" />
                            <ui:VisualElement class="icon icon-coin icon-gap" picking-mode="Ignore" />
                            <ui:Label name="buybackCost" text="0" class="btn-label btn-label-dark" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:VisualElement name="collectionPage" class="page page--panel hidden">
                        <ui:VisualElement class="ribbon" picking-mode="Ignore">
                            <ui:Label text="#ui.collection" class="ribbon-label" />
                        </ui:VisualElement>
                        <ui:Label text="#ui.collection.hint" class="dialog-hint" />
                        <ui:VisualElement name="collectionGrid" class="card-grid" />
                    </ui:VisualElement>

                    <ui:VisualElement name="storePage" class="page page--panel hidden">
                        <ui:VisualElement class="ribbon" picking-mode="Ignore">
                            <ui:Label text="#ui.store" class="ribbon-label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="storeList" class="store-list" />
                    </ui:VisualElement>

                    <ui:VisualElement name="settingsPage" class="page page--panel hidden">
                        <ui:VisualElement class="ribbon" picking-mode="Ignore">
                            <ui:Label text="#ui.settings" class="ribbon-label" />
                        </ui:VisualElement>

                        <ui:VisualElement class="setting-row">
                            <ui:VisualElement class="setting-head" picking-mode="Ignore">
                                <ui:VisualElement class="icon icon-small icon-globe setting-icon" />
                                <ui:Label text="#ui.settings.language" class="setting-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="segment-group">
                                <ui:Button name="languageTr" class="segment">
                                    <ui:Label text="#ui.settings.language.tr" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button name="languageEn" class="segment">
                                    <ui:Label text="#ui.settings.language.en" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="setting-row">
                            <ui:VisualElement class="setting-head" picking-mode="Ignore">
                                <ui:VisualElement class="icon icon-small icon-sound setting-icon" />
                                <ui:Label text="#ui.settings.sound" class="setting-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="segment-group">
                                <ui:Button name="soundOn" class="segment">
                                    <ui:Label text="#ui.settings.on" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button name="soundOff" class="segment">
                                    <ui:Label text="#ui.settings.off" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="setting-row">
                            <ui:VisualElement class="setting-head" picking-mode="Ignore">
                                <ui:VisualElement class="icon icon-small icon-display setting-icon" />
                                <ui:Label text="#ui.settings.quality" class="setting-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="segment-group">
                                <ui:Button name="qualityLow" class="segment">
                                    <ui:Label text="#ui.settings.quality.low" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button name="qualityMedium" class="segment">
                                    <ui:Label text="#ui.settings.quality.medium" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button name="qualityHigh" class="segment">
                                    <ui:Label text="#ui.settings.quality.high" class="segment-label" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Label text="#ui.dev" class="eyebrow setting-section" />
                        <ui:VisualElement class="dev-card">
                            <ui:VisualElement class="dev-avatar" picking-mode="Ignore">
                                <ui:Label text="#ui.dev.initials" class="dev-initials" />
                            </ui:VisualElement>
                            <ui:VisualElement class="dev-info" picking-mode="Ignore">
                                <ui:Label text="#ui.dev.name" class="dev-name" />
                                <ui:Label text="#ui.dev.role" class="dev-role" />
                                <ui:Label text="#ui.dev.location" class="dev-meta" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="developerButton" class="btn btn-secondary dev-button">
                            <ui:VisualElement class="icon icon-code" picking-mode="Ignore" />
                            <ui:Label text="#ui.dev.github" class="btn-label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Label name="versionLabel" class="version-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="tab-bar">
                        <ui:Button name="homeTab" class="tab">
                            <ui:VisualElement class="tab-icon tab-icon--home" picking-mode="Ignore" />
                            <ui:Label text="#ui.tab.home" class="tab-label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="collectionTab" class="tab">
                            <ui:VisualElement class="tab-icon tab-icon--collection" picking-mode="Ignore" />
                            <ui:Label text="#ui.tab.collection" class="tab-label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="storeTab" class="tab">
                            <ui:VisualElement class="tab-icon tab-icon--store" picking-mode="Ignore" />
                            <ui:Label text="#ui.store" class="tab-label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="settingsTab" class="tab">
                            <ui:VisualElement class="tab-icon tab-icon--settings" picking-mode="Ignore" />
                            <ui:Label text="#ui.tab.settings" class="tab-label" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="hudScreen" class="screen screen--out hidden" picking-mode="Ignore">
            <ui:VisualElement class="safe-area" picking-mode="Ignore">
                <ui:VisualElement class="screen-content" picking-mode="Ignore">
                    <ui:VisualElement class="top-bar" picking-mode="Ignore">
                        <ui:Button name="pauseButton" class="icon-button">
                            <ui:VisualElement class="icon icon-pause" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:VisualElement class="score-block" picking-mode="Ignore">
                            <ui:Label text="#ui.score" class="eyebrow eyebrow--over-scene" />
                            <ui:Label name="scoreValue" text="0" class="score-value over-scene" />
                        </ui:VisualElement>
                        <ui:VisualElement name="coinChip" class="chip">
                            <ui:VisualElement class="icon icon-coin" />
                            <ui:Label name="coinValue" text="0" class="chip-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="effectBadge" class="effect-badge hidden" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon-small icon-bolt" />
                        <ui:Label name="effectName" class="effect-name" />
                        <ui:Label name="effectTime" class="effect-time" />
                    </ui:VisualElement>
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-bottom" picking-mode="Ignore">
                        <ui:VisualElement class="hud-left" picking-mode="Ignore">
                            <ui:Button name="accessoryButton" class="chip chip-button hidden">
                                <ui:VisualElement class="icon icon-chair" picking-mode="Ignore" />
                                <ui:Label name="hudAccessoryCount" text="0" class="chip-value" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:Button name="abilityButton" class="ability-button">
                            <OutOfOffice.UI.RadialProgress name="abilityRing" class="ability-ring" picking-mode="Ignore" />
                            <ui:VisualElement class="icon icon-large icon-bolt" picking-mode="Ignore" />
                            <ui:Label name="abilityName" class="ability-name" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="pauseScreen" class="screen overlay screen--out hidden">
            <ui:VisualElement class="safe-area" picking-mode="Ignore">
                <ui:VisualElement class="screen-content screen-content--center" picking-mode="Ignore">
                    <ui:VisualElement class="card card--dialog">
                        <ui:VisualElement class="ribbon" picking-mode="Ignore">
                            <ui:Label text="#ui.paused" class="ribbon-label" />
                        </ui:VisualElement>
                        <ui:Button name="resumeButton" class="btn btn-primary">
                            <ui:VisualElement class="icon icon-play" picking-mode="Ignore" />
                            <ui:Label text="#ui.resume" class="btn-label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="pauseMenuButton" class="btn btn-secondary">
                            <ui:VisualElement class="icon icon-home" picking-mode="Ignore" />
                            <ui:Label text="#ui.menu" class="btn-label" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameOverScreen" class="screen overlay screen--out hidden">
            <ui:VisualElement class="safe-area" picking-mode="Ignore">
                <ui:VisualElement class="screen-content screen-content--center" picking-mode="Ignore">
                    <ui:VisualElement class="card card--dialog">
                        <ui:VisualElement class="ribbon ribbon--danger" picking-mode="Ignore">
                            <ui:Label text="#ui.gameover" class="ribbon-label" />
                        </ui:VisualElement>
                        <ui:Label text="#ui.gameover.eyebrow" class="eyebrow eyebrow--danger" />

                        <ui:VisualElement name="reviveGroup" class="dialog-group hidden">
                            <ui:Label text="#ui.revive.hint" class="dialog-hint" />
                            <ui:Button name="reviveButton" class="btn btn-accent">
                                <ui:Label text="#ui.continue" class="btn-label btn-label-dark" picking-mode="Ignore" />
                                <ui:VisualElement class="icon icon-key icon-gap" picking-mode="Ignore" />
                                <ui:Label name="reviveCost" text="1" class="btn-label btn-label-dark" picking-mode="Ignore" />
                            </ui:Button>
                            <ui:Button name="giveUpButton" class="btn btn-secondary">
                                <ui:Label text="#ui.giveup" class="btn-label" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>

                        <ui:VisualElement name="resultGroup" class="dialog-group">
                            <ui:Label name="finalScoreValue" text="0" class="final-score" />
                            <ui:VisualElement name="automatedBadge" class="danger-chip danger-chip--row hidden">
                                <ui:Label name="automatedName" class="danger-chip-label" />
                                <ui:Label text="#ui.automated.suffix" class="danger-chip-label danger-chip-suffix" />
                            </ui:VisualElement>
                            <ui:VisualElement name="newBestBadge" class="new-best hidden">
                                <ui:Label text="#ui.newbest" class="new-best-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-row">
                                <ui:VisualElement class="stat">
                                    <ui:VisualElement class="icon icon-trophy" />
                                    <ui:Label text="#ui.best" class="stat-label" />
                                    <ui:Label name="finalBestValue" text="0" class="stat-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat">
                                    <ui:VisualElement class="icon icon-coin" />
                                    <ui:Label text="#ui.coins" class="stat-label" />
                                    <ui:Label name="finalCoinsValue" text="0" class="stat-value" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="rewardsBlock" class="rewards-block hidden">
                                <ui:VisualElement class="rewards-title">
                                    <ui:VisualElement class="icon icon-small icon-package" />
                                    <ui:Label text="#ui.rewards" class="eyebrow eyebrow--left" />
                                </ui:VisualElement>
                                <ui:VisualElement name="rewardsRow" class="rewards-row" />
                            </ui:VisualElement>
                            <ui:Button name="retryButton" class="btn btn-primary">
                                <ui:VisualElement class="icon icon-retry" picking-mode="Ignore" />
                                <ui:Label text="#ui.retry" class="btn-label" picking-mode="Ignore" />
                            </ui:Button>
                            <ui:Button name="gameOverMenuButton" class="btn btn-secondary">
                                <ui:VisualElement class="icon icon-home" picking-mode="Ignore" />
                                <ui:Label text="#ui.menu" class="btn-label" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
